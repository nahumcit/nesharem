---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { langMeta, languages, type Lang } from '../i18n/ui';
import { swapLang, t } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  translations?: Partial<Record<Lang, string | null>>;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  lang,
  title,
  description,
  translations,
  image = '/avatar.png',
  noindex = false,
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const alternates = Object.fromEntries(
  languages
    .map((code) => [
      code,
      translations?.[code] === null
        ? null
        : (translations?.[code] ?? swapLang(Astro.url.pathname, code)),
    ])
    .filter(([, href]) => Boolean(href))
) as Partial<Record<Lang, string>>;

const xDefault = alternates.es ?? alternates.en ?? canonical;
---

<!doctype html>
<html lang={langMeta[lang].htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    {
      Object.entries(alternates).map(([code, href]) => (
        <link
          rel="alternate"
          hreflang={langMeta[code as Lang].htmlLang}
          href={new URL(href as string, site.url).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site.url).href} />
    <link rel="alternate" type="application/rss+xml" title={`nesharem · RSS · ${langMeta[lang].short}`} href={`/${lang}/rss.xml`} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="nesharem" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#eaf7ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#06131f" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      try {
        var saved = localStorage.getItem('nesharem-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (error) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <div class="page-loader" aria-hidden="true"><span class="loader"></span></div>
    <Header lang={lang} translations={translations} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
